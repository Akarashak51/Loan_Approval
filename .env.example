# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file.

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
PORT=5000

# --- MySQL ---
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/xai_loan_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=xai_loan_db

# --- ML ---
MODEL_PATH=../ml/models/saved/model.joblib
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional OpenAI-compatible chat completions endpoint.
# LLM_API_URL=https://api.openai.com/v1/chat/completions

# --- Private document storage (must not be a public/static directory) ---
DOCUMENT_UPLOAD_DIR=./private_uploads
MAX_DOCUMENT_SIZE_BYTES=5242880

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend (frontend/.env) ---
# VITE_API_BASE_URL=/api

# --- Optional Google sign-in ---
# Backend only. Never put GOOGLE_CLIENT_SECRET in frontend/.env or VITE_* vars.
# Create OAuth web credentials in Google Cloud, then add this exact callback
# URL to its authorised redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
# Applicant document pipeline: generate a private stable secret before use.
AADHAAR_HASH_KEY=
# Optional full executable path when Tesseract is not on PATH.
# Windows example: C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
DOCUMENT_NAME_THRESHOLD=88
DOCUMENT_SALARY_TOLERANCE=0.02
DOCUMENT_OCR_DIAGNOSTICS=false
DOCUMENT_OCR_RAW_DEBUG=false
BANK_DOCUMENT_FEATURES=false
